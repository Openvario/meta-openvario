From: OpenVario <openvario@localhost>
Subject: [PATCH] Draw startup status immediately with space above the progress bar

Keep the built-in bitmap font at its original size and leave a 16-pixel
gap above the progress bar. Draw the initial status as part of the first
splash scene, before system initialization starts.

Upstream-Status: Inappropriate [OpenVario splash appearance]

--- a/psplash-config.h
+++ b/psplash-config.h
@@ -13,8 +13,11 @@
 
 /* Text to output on program start; if undefined, output nothing */
 #ifndef PSPLASH_DISABLE_STARTUP_MSG
-#define PSPLASH_STARTUP_MSG ""
+#define PSPLASH_STARTUP_MSG "Preparing OpenVario..."
 #endif
+
+/* Gap between the bottom of the text and the progress bar, in pixels. */
+#define PSPLASH_TEXT_GAP 16
 
 /* Bool indicating if the image is fullscreen, as opposed to split screen */
 #ifndef PSPLASH_IMG_FULLSCREEN
--- a/psplash.c
+++ b/psplash.c
@@ -48,14 +48,14 @@
 
   psplash_fb_draw_rect (fb, 
 			0, 
-			SPLIT_LINE_POS(fb) - h, 
+			SPLIT_LINE_POS(fb) - h - PSPLASH_TEXT_GAP, 
 			fb->width,
 			h,
 			PSPLASH_BACKGROUND_COLOR);
 
   psplash_fb_draw_text (fb,
 			(fb->width-w)/2, 
-			SPLIT_LINE_POS(fb) - h,
+			SPLIT_LINE_POS(fb) - h - PSPLASH_TEXT_GAP,
 			PSPLASH_TEXT_COLOR,
 			&FONT_DEF,
 			msg);
