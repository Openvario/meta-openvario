[Unit]
Description=OVMenu Next-Generation

# No getty on tty1
Conflicts=getty@tty1.service

Requires=ov-system-init.service
Wants=systemd-vconsole-setup.service
After=systemd-vconsole-setup.service ov-system-init.service

# Wait for psplash so the stop command below doesn't race it.
After=psplash-start.service

After=systemd-user-sessions.service plymouth-quit-wait.service getty-pre.target
After=rc-local.service

# If additional gettys are spawned during boot then we should make
# sure that this is synchronized before getty.target, even though
# getty.target didn't actually pull it in.
Before=getty.target
IgnoreOnIsolate=yes

# IgnoreOnIsolate causes issues with sulogin, if someone isolates
# rescue.target or starts rescue.service from multi-user.target or
# graphical.target.
Conflicts=rescue.service
Before=rescue.service

# On systems without virtual consoles, don't start any getty. Note
# that serial gettys are covered by serial-getty@.service, not this
# unit.
ConditionPathExists=/dev/tty0

# This service can be used to manipulate settings in /boot/config.uEnv
Wants=boot.automount
After=boot.automount

[Service]
ExecStartPre=-/usr/bin/psplash-message "Starting application..."
# Stop psplash before starting the menu.
ExecStartPre=-/bin/systemctl stop psplash-start
# Ensure ovmenu-ng starts on the dedicated local console.
ExecStartPre=-/usr/bin/chvt 1
ExecStartPre=/usr/libexec/openvario/xcsoar-exclusive-handoff prepare /run/xcsoar-exclusive-handoff
ExecStart=/usr/bin/ovmenu-ng.sh
Type=simple
Restart=always
RestartSec=0

RuntimeDirectory=xcsoar-exclusive-handoff
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=restart

Environment=HOME=/home/root
Environment=XCSOAR_EXCLUSIVE_HANDOFF_DIR=/run/xcsoar-exclusive-handoff

TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
IgnoreSIGPIPE=no
SendSIGHUP=yes

StandardInput=tty
StandardOutput=tty
StandardError=journal

Slice=user.slice

[Install]
WantedBy=getty.target
