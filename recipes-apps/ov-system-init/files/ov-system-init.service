[Unit]
Description=OpenVario System Initialization
Requires=ov-data-storage.service
After=ov-data-storage.service boot.automount psplash-start.service
Wants=boot.automount

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/ov-system-init.sh
Environment=HOME=/home/root
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
