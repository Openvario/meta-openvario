# -------------
# OpenVario-specific XCI overlay
# Loaded after default.xci
# -------------

# -------------
# Preserve the OpenVario remote firmware bindings.
# F5 opens the waypoint chooser; F6 opens Alternates.
# -------------

mode=default
type=key
data=F5
event=GotoLookup
event=Mode default

mode=default
type=key
data=F6
event=Setup Alternates
event=Mode default

# -------------
# Quickmenu: Vario menu
# Vario at location=19 replaces upstream MacCready,
# which is still accessible inside the Vario_menu
# -------------

mode=RemoteStick
type=key
data=0
event=Mode Vario_menu
label=Vario
location=19


# -------------
# Vario_menu: XCSoar audio vario control
# -------------

mode=Vario_menu
type=key
data=UP
event=VarioVolume up
label=VOLUME+ (UP)
location=1

mode=Vario_menu
type=key
data=DOWN
event=VarioVolume down
label=VOLUME- (DOWN)
location=2

mode=Vario_menu
type=key
data=RETURN
event=VarioVolume mute
label=VOLUME ON/OFF (ENT)
location=3

mode=Vario_menu
type=key
data=S
event=VarioAudioMode show
event=VarioAudioMode stf
label=STF
location=5

mode=Vario_menu
type=key
data=V
event=VarioAudioMode show
event=VarioAudioMode vario
label=VARIO
location=6

mode=Vario_menu
type=key
data=LEFT
event=MacCready down
label=MC- (LEFT)
location=7

mode=Vario_menu
type=key
data=RIGHT
event=MacCready up
label=MC+ (RIGHT)
location=8

mode=Vario_menu
type=key
data=ESCAPE
event=Mode default
label=BACK (ESC)
location=9


# -------------
# Automatic vario / speed to fly switching is available by selecting
# "Auto" in XCSoar's Audio Vario settings. It can also be selected from
# an input binding with the event "VarioAudioMode auto".
# -------------

# -------------
# Vario / speed to fly with switch on remote stick
# Remote sends V for vario, S for STF and M for Vario_menu
# -------------

mode=default
type=key
data=V
event=VarioAudioMode show
event=VarioAudioMode vario

mode=default
type=key
data=S
event=VarioAudioMode show
event=VarioAudioMode stf

mode=default RemoteStick
type=key
data=M
event=Mode Vario_menu
