#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-only

set -eu

# shellcheck source=/dev/null
. "${OV_PATHS:-/usr/libexec/openvario/paths.sh}" || exit 1
MOUNTPOINT_CMD=${OV_MOUNTPOINT:-/bin/mountpoint}
CONFIG_FILE=${VARIOD_CONFIG_FILE:-/opt/conf/variod.conf}
DEFAULT_FILE=${VARIOD_DEFAULT_FILE:-/opt/conf/default/variod.conf}

if ! "$MOUNTPOINT_CMD" -q "$DATA_DIR"; then
  echo "Persistent data is not mounted at $DATA_DIR." >&2
  exit 1
fi

mkdir -p "$VARIOD_DIR" "$(dirname "$CONFIG_FILE")" || exit 1
chmod 0700 "$VARIOD_DIR" || exit 1

if [ ! -s "$VARIOD_FILE" ]; then
  if [ ! -s "$DEFAULT_FILE" ]; then
    echo "The default variod configuration is unavailable." >&2
    exit 1
  fi

  temporary=$(mktemp "${VARIOD_FILE}.tmp.XXXXXX") || exit 1
  if ! cp "$DEFAULT_FILE" "$temporary" ||
    ! chmod 0600 "$temporary" ||
    ! mv "$temporary" "$VARIOD_FILE"; then
    rm -f "$temporary"
    exit 1
  fi
fi

ln -sfn "$VARIOD_FILE" "$CONFIG_FILE" || exit 1
echo "variod configuration is persistent at $VARIOD_FILE."
